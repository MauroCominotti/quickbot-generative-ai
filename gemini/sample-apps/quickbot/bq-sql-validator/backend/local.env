ENVIRONMENT="development"
FRONTEND_URL="http://localhost:4200"

# --- Google Cloud Configuration ---
# Required for using Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT="poc-env-aks-bq-admin" 
GOOGLE_CLOUD_LOCATION="us-central1"     

# --- Optional: Agent Engine Configuration ---
GOOGLE_CLOUD_STORAGE_BUCKET="agent-engine-2025" # Used for deploying to Agent Engine on Vertex AI

#Agent Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GCP_PROJECT="poc-env-aks-bq-admin" 
GCP_LOCATION="us-central1"
VALIDATION_OUTPUT_TABLE = poc-env-aks-bq-admin.gemini_sql_validator.validation_output
STAGING_BUCKET = gs://agent-engine-2025


# --- App Configuration ---
BIG_QUERY_DATASET=quick_bot_app
